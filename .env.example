PORT=50000
APP_ACCESS_TOKEN=
LOG_REQUEST_BODY=false
GEMINI_API_KEY=
# osh-ai-gateway 경유 (권장 — homelab .25)
GEMINI_GATEWAY_BASE_URL=http://192.168.11.25/llm/gemini
GEMINI_GATEWAY_TOKEN=
GEMINI_SERVICE_ID=simpleStock
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SUPERVISOR_MODEL=gemini-3.5-flash
GEMINI_SUPERVISOR_TIMEOUT_MS=90000
GEMINI_INCLUDE_THOUGHTS=false
GEMINI_THINKING_BUDGET=1024
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=1500
APP_TIMEZONE=Asia/Seoul
# 평일 6회 일일 보고(22·23·06·09·10·18시)는 기본 preset 사용. 레거시 단일 cron만 쓰려면:
# MANAGER_BRIEF_PRESET_SCHEDULE=false
# AI_DAILY_CRON=5 21 * * *
MANAGER_BRIEF_PRESET_SCHEDULE=true
AI_DAILY_CRON=
TZ=Asia/Seoul
MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDER=finnhub
MARKET_US_PROVIDER=finnhub
# KR 주가 provider: myapi|public-data-portal|yahoo-finance
# 기본값 myapi(네이버 실시간, 생태계 단일화). MYAPI_BASE_URL 미설정 시 자동 public-data-portal 폴백.
# 공공데이터포털을 강제하려면 아래에 public-data-portal 을 명시.
MARKET_KR_PROVIDER=
MARKET_FX_PROVIDER=yahoo-finance
# 생태계 단일 주가 소스(myapi) base-url. 비워두면 myapi provider 비활성(기존 소스 사용 = 하위호환).
# 예: http://192.168.11.25/myapi 또는 http://127.0.0.1/myapi
MYAPI_BASE_URL=
MARKET_REFRESH_INTERVAL_MS=60000
MARKET_QUOTE_TTL_MS=60000
MARKET_KR_QUOTE_TTL_MS=600000
# 게이트웨이 하위 경로 배포 시 필수 (예: /simpleStock/). 단독 실행·로컬 dev 는 비워 둠.
VITE_BASE_PATH=
# 한국 시세: 최근 영업일 조회 수(기본 2), 한도 초과 시 재시도 중단 시간(ms, 기본 30분)
MARKET_KR_BAS_DT_LOOKBACK_DAYS=2
MARKET_KR_QUOTA_BACKOFF_MS=1800000
FINNHUB_API_KEY=
# 공공데이터포털 「디코딩」 인증키 (Encoding 키가 아님)
PUBLIC_DATA_API_KEY=
USD_KRW_FALLBACK_RATE=1360
